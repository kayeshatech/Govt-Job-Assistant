# ==========================================
# Govexa Backend Environment Variables
# ==========================================

# Application Metadata
PROJECT_NAME="Govexa Government Exam Intelligence API"
VERSION="2.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="production" # "development" | "production"

# Network & Server
HOST="0.0.0.0"
PORT=8000

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","https://govexa.vercel.app","https://your-custom-domain.com"]

# ==========================================
# Database Configuration (Supabase PostgreSQL)
# ==========================================
# For production (Render + Supabase):
# Use PostgreSQL Transaction Pooler (port 6543) or Session Pooler (port 5432)
# Format: postgresql+psycopg2://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql+psycopg2://postgres.yourprojectref:yourpassword@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# For local development SQLite fallback (optional):
# DATABASE_URL="sqlite:///./govexa.db"

# ==========================================
# Supabase Authentication & Cryptographic Keys
# ==========================================
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase JWT Secret (from Supabase Dashboard -> Project Settings -> API -> JWT Settings)
# Used to verify user identity claims and prevent forged sessions:
SUPABASE_JWT_SECRET="your-supabase-jwt-secret-minimum-32-characters"
SUPABASE_JWT_ALGORITHM="HS256"

# Supabase Service Role Key (NEVER expose to frontend; backend use only):
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Administrative accounts allowed to review gazettes and audit logs
ADMIN_EMAILS=["admin@govexa.gov.in","officer@govexa.gov.in"]
