# ==============================================================================
# Govexa Backend - Production Environment Example (Render + Supabase + Gemini)
# Copy this file to .env in your production environment and populate real credentials.
# DO NOT COMMIT REAL CREDENTIALS OR SERVICE KEYS TO SOURCE CONTROL.
# ==============================================================================

# Application Metadata
PROJECT_NAME="Govexa Government Exam Intelligence API"
VERSION="5.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="production"

# Network & Server (Render binds dynamically to $PORT and 0.0.0.0)
HOST="0.0.0.0"
PORT=10000

# CORS Allowed Origins
# Include your Vercel production domain and optional preview domains:
CORS_ORIGINS=["https://govexa.vercel.app","https://your-custom-domain.com"]

# ==============================================================================
# Database Configuration (Supabase PostgreSQL via Connection Pooler)
# ==============================================================================
# Use transaction pooler (port 6543) for stateless API endpoints to optimize connections:
# Format: postgresql+psycopg2://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL="postgresql+psycopg2://postgres.yourprojectref:your_strong_password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres"

# Connection Pooling Tuning for Render Free/Starter tiers:
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ==============================================================================
# Supabase Authentication & Cryptographic Keys
# ==============================================================================
SUPABASE_URL="https://yourprojectref.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key..."

# Supabase JWT Secret (Dashboard -> Settings -> API -> JWT Settings)
# Used for HMAC-SHA256 signature verification of user Bearer tokens:
SUPABASE_JWT_SECRET="your_supabase_jwt_secret_minimum_32_characters_long"
SUPABASE_JWT_ALGORITHM="HS256"

# Supabase Service Role Key (NEVER expose to frontend; backend use only):
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key..."

# Administrative accounts allowed to review gazettes, change logs, and audit logs:
ADMIN_EMAILS=["admin@govexa.gov.in","evaluator@govexa.gov.in"]

# ==============================================================================
# Artificial Intelligence & LLM Provider Configuration
# ==============================================================================
LLM_PROVIDER="gemini"
GEMINI_API_KEY="AIzaSyYourProductionGeminiApiKeyHere"
GEMINI_MODEL="gemini-1.5-flash"
EMBEDDING_MODEL="text-embedding-004"

# AI Usage Safeguards & Rate Limiting
MAX_LLM_TOKENS_PER_DAY=1000000
RATE_LIMIT_PER_MINUTE=60

# Background Worker Settings
MONITORING_INTERVAL_SECONDS=3600
AUTO_EXTRACT_ON_DISCOVERY=true
