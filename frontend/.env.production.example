# ==============================================================================
# Govexa Frontend - Production Environment Example (Vercel)
# Configure these variables in the Vercel Project Settings -> Environment Variables.
# All VITE_ variables are embedded in the client bundle; NEVER include secrets.
# ==============================================================================

# Production FastAPI Backend URL on Render
VITE_API_BASE_URL=https://govexa-api.onrender.com/api/v1

# Supabase Public Configuration (Safe for client browsers)
VITE_SUPABASE_URL=https://yourprojectref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key...

# Application Branding
VITE_APP_NAME=Govexa
VITE_APP_TAGLINE=AI-Powered Indian Government Exam Career Guidance & Preparation Platform

# Feature Flags
# In production, mock fallback is set to false to enforce authentic live API communications:
VITE_ENABLE_MOCK_FALLBACK=false
