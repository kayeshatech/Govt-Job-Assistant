# Govexa AI Government Exam Career Guidance & Preparation Platform
# Frontend Environment Configuration

# FastAPI Backend URL
# Local Development: http://localhost:8000/api/v1
# Production (Render): https://govexa-api.onrender.com/api/v1
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase Public Configuration (Safe for Browser)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# CRITICAL SECURITY RULE: NEVER expose SUPABASE_SERVICE_ROLE_KEY to the frontend!

# Application Identity & Branding
VITE_APP_NAME=Govexa
VITE_APP_TAGLINE=AI-Powered Indian Government Exam Career Guidance & Preparation Platform

# Feature Flags
# If true, falls back to rich sample fixtures if backend is offline or during prototype demonstrations
VITE_ENABLE_MOCK_FALLBACK=true
